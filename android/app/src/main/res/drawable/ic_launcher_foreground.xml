<?xml version="1.0" encoding="utf-8"?>
<!-- 心光 MHOP 品牌插画前景层：两座 M 形 teal 山峰 + 白色太阳 + 白色心形
     配色：后山 #1A6B62 深 teal / 前山 #2F8F83 主题 teal / 最前山 #5EAAA1 薄荷绿 / 太阳+心 #FFFFFF -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 第一层：后山（深 teal），两座 M 形平滑山峰，峰顶圆弧 -->
    <path
        android:fillColor="#1A6B62"
        android:pathData="
            M 10,98
            C 16,66  14,38  22,28
            C 30,22  40,32  54,48
            C 68,32  78,22  86,28
            C 94,38  92,66  98,98
            Z" />

    <!-- 第二层：前山（主题 teal），两山之间的前凸山坡 -->
    <path
        android:fillColor="#2F8F83"
        android:pathData="
            M 10,98
            C 24,78  34,64  54,58
            C 74,64  84,78  98,98
            Z" />

    <!-- 第三层：最前山（薄荷绿），底部缓坡 -->
    <path
        android:fillColor="#5EAAA1"
        android:pathData="
            M 10,98
            C 22,92  38,86  54,82
            C 70,86  86,92  98,98
            Z" />

    <!-- 白色太阳（圆心 54,52，半径 12），置于后山凹槽 -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M54,40 A12,12 0 1,0 54,64 A12,12 0 1,0 54,40 Z" />

    <!-- 白色心形（底部中央，前层山坡上） -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="
            M 54,80
            C 49,74  40,78  43,86
            C 46,92  54,98  54,98
            C 54,98  62,92  65,86
            C 68,78  59,74  54,80
            Z" />
</vector>
