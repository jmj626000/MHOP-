    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Mhop</RootNamespace>
    <AssemblyName>Mhop.Api</AssemblyName>
    <InvariantGlobalization>false</InvariantGlobalization>
