# 复制本文件为 .env，填入真实凭证。.env 已被 .gitignore 忽略，不会进入开源仓库。

# LLM（OpenAI 兼容协议，必须使用 https）
# 讯飞星火：鉴权口令格式为 APIKey:APISecret（APPID 不用于该 HTTP 兼容接口）
LLM_BASE_URL=https://spark-api-open.xf-yun.com/v1
LLM_API_KEY=在此填入 APIKey:APISecret
LLM_MODEL=4.0Ultra

# 数据库（默认 SQLite 零配置；生产可换 MySQL）
# DATABASE_URL=mysql+pymysql://user:password@host:3306/mhop?charset=utf8mb4

# JWT 生产环境务必修改
# JWT_SECRET=change-me-in-production

# 合作机构援助热线（可选）
# LEKE_HOTLINE=

# SMTP 邮箱发信（邮箱验证码登录用）。SMTP_HOST 留空 = 开发模式：验证码不真正发送，
# 会写在后端日志里，且发送接口临时返回 dev_code 供本机联调。
# QQ 邮箱：SMTP_HOST=smtp.qq.com  SMTP_PORT=465  SMTP_USE_SSL=true
# 163 邮箱：SMTP_HOST=smtp.163.com SMTP_PORT=465 SMTP_USE_SSL=true
# Gmail：  SMTP_HOST=smtp.gmail.com SMTP_PORT=587 SMTP_USE_SSL=false
# 注意：SMTP_PASSWORD 填邮箱设置里生成的“授权码/应用专用密码”，不是邮箱登录密码。
# SMTP_HOST=smtp.qq.com
# SMTP_PORT=465
# SMTP_USER=your_mail@qq.com
# SMTP_PASSWORD=授权码
# SMTP_FROM=MHOP 心理辅助平台 <your_mail@qq.com>
# SMTP_USE_SSL=true
