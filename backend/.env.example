# 复制本文件为 .env，填入真实凭证。.env 已被 .gitignore 忽略，不会进入开源仓库。

# LLM（OpenAI 兼容协议，必须使用 https）
# 讯飞星火：鉴权口令格式为 APIKey:APISecret（APPID 不用于该 HTTP 兼容接口）
LLM_BASE_URL=https://spark-api-open.xf-yun.com/v1
LLM_API_KEY=在此填入 APIKey:APISecret
LLM_MODEL=4.0Ultra

# 数据库（默认 SQLite 零配置；生产可换 MySQL）
# DATABASE_URL=mysql+pymysql://user:password@host:3306/mhop?charset=utf8mb4

# JWT 生产环境务必修改
# JWT_SECRET=change-me-in-production

# 合作机构援助热线（可选）
# LEKE_HOTLINE=
