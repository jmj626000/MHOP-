# docker compose 变量文件示例：
# 复制为仓库根目录的 .env（已被 .gitignore 忽略），按部署形态填写。

# ── 形态 A：有域名，80/443 可用 ──
# Caddy 会自动为该域名申请 HTTPS 证书，请确保域名 A 记录已指向本服务器，且 80/443 放行。
# 启动命令：docker compose --profile tls up -d --build
DOMAIN=mhop.example.com

# ── 形态 B：无域名 / 只有高位端口（如 10000-10008）──
# 后端直接对外提供 HTTP（含 API 与已打包的前端页面）。
# 启动命令：docker compose up -d --build，访问 http://服务器IP:10000
# BACKEND_PUBLISH=10000

# 如使用外部 MySQL，取消下一行注释（同时 backend/.env 中不要再重复设置 DATABASE_URL）：
# DATABASE_URL=mysql+pymysql://mhop:强密码@db-host:3306/mhop?charset=utf8mb4
